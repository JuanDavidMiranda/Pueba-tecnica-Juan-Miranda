{
  "name": "sihos/pacientes",
  "description": "Prueba técnica EST-SEM SIHOS: API REST y censo de pacientes.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": "php bin/setup.php",
    "serve": "php -d upload_max_filesize=4M -d post_max_size=12M -S 0.0.0.0:8741 -t public public/router.php",
    "test": "phpunit --colors=always"
  },
  "config": {
    "sort-packages": true
  }
}
